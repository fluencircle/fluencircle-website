{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid)",
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['email', 'role'])",
        "firstName": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
        },
        "lastName": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254 && newData.val().matches(/^[^@ ]+@[^@ ]+$/)"
        },
        "role": {
          ".validate": "newData.val() === 'student' || newData.val() === 'mediator' || newData.val() === 'admin'"
        },
        "planId": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/) && root.child('plans').child(newData.val()).exists()"
        },
        "plan": {
          ".validate": "data.exists() && newData.val() === data.val()"
        },
        "planName": {
          ".validate": "data.exists() && newData.val() === data.val()"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
        },
        "updatedAt": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "plans": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
      "$planId": {
        ".read": "((auth != null && root.child('users').child(auth.uid).exists()) && ((root.child('users').child(auth.uid).child('planId').isString() && root.child('users').child(auth.uid).child('planId').val().matches(/^[A-Za-z0-9_-]{1,64}$/) && root.child('users').child(auth.uid).child('planId').val() === $planId) || (!root.child('users').child(auth.uid).child('planId').exists() && root.child('users').child(auth.uid).child('plan').isString() && root.child('users').child(auth.uid).child('plan').val().matches(/^[A-Za-z0-9_-]{1,64}$/) && root.child('users').child(auth.uid).child('plan').val() === $planId)))",
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['name', 'price', 'sessions']) && $planId.matches(/^[A-Za-z0-9_-]{1,64}$/) && (!data.child('nextSessionIndex').exists() || (newData.child('nextSessionIndex').exists() && newData.child('nextSessionIndex').val() >= data.child('nextSessionIndex').val()))",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "nextSessionIndex": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000"
        },
        "sessions": {
          "$index": {
            ".validate": "$index.matches(/^(0|[1-9][0-9]{0,5})$/) && newData.hasChildren(['dayOfWeek', 'startTime', 'endTime'])",
            "dayOfWeek": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 6"
            },
            "startTime": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "endTime": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
        },
        "updatedAt": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "weekly_sessions": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
      "$weekKey": {
        ".validate": "$weekKey.matches(/^[0-9]{4}-W[0-9]{2}$/)",
        "$slotKey": {
          ".read": "((auth != null && root.child('users').child(auth.uid).exists()) && ((root.child('users').child(auth.uid).child('planId').isString() && root.child('users').child(auth.uid).child('planId').val().matches(/^[A-Za-z0-9_-]{1,64}$/) && $slotKey.beginsWith(root.child('users').child(auth.uid).child('planId').val() + '_') && $slotKey.replace(root.child('users').child(auth.uid).child('planId').val() + '_', '').matches(/^[0-6]_(0|[1-9][0-9]{0,5})$/)) || (!root.child('users').child(auth.uid).child('planId').exists() && root.child('users').child(auth.uid).child('plan').isString() && root.child('users').child(auth.uid).child('plan').val().matches(/^[A-Za-z0-9_-]{1,64}$/) && $slotKey.beginsWith(root.child('users').child(auth.uid).child('plan').val() + '_') && $slotKey.replace(root.child('users').child(auth.uid).child('plan').val() + '_', '').matches(/^[0-6]_(0|[1-9][0-9]{0,5})$/))))",
          ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "newData.hasChildren(['topicTitle', 'updatedAt']) && $slotKey.matches(/^[A-Za-z0-9_-]+_[0-6]_(0|[1-9][0-9]{0,5})$/)",
          "topicId": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
          },
          "topicTitle": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "questions": {
            "$index": {
              ".validate": "$index.matches(/^[0-9]+$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            }
          },
          "meetLink": {
            ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https:[/][/][A-Za-z0-9._~:/?#@!$&()*+,;=%-]+$/)"
          },
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "deleted_users": {
      ".read": "(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid)",
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['deletedAt'])",
        "deletedAt": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
        },
        "deletedBy": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 254"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "meetings": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
      "$themeId": {
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        ".validate": "newData.hasChildren(['topic', 'questions'])",
        "topic": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "questions": {
          "$index": {
            ".validate": "$index.matches(/^[0-9]+$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          }
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
        },
        "updatedAt": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "meeting_sessions": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
      "$sessionId": {
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        ".validate": "newData.hasChildren(['topic', 'startedAt'])",
        "templateId": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
        },
        "topic": {
          ".read": "((auth != null && root.child('users').child(auth.uid).exists()) && (root.child('user_sessions').child(auth.uid).child($sessionId).exists() || root.child('meeting_sessions').child($sessionId).child('attendees').child(auth.uid).exists()))",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "startedAt": {
          ".read": "((auth != null && root.child('users').child(auth.uid).exists()) && (root.child('user_sessions').child(auth.uid).child($sessionId).exists() || root.child('meeting_sessions').child($sessionId).child('attendees').child(auth.uid).exists()))",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
        },
        "mediatorEmail": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 254 && (data.exists() ? newData.val() === data.val() : newData.val() === auth.token.email)"
        },
        "attendees": {
          "$uid": {
            ".validate": "newData.hasChildren(['addedAt']) && root.child('users').child($uid).exists() && newData.parent().parent().parent().parent().child('user_sessions').child($uid).child($sessionId).exists()",
            "addedAt": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "current_session": {
      ".read": true,
      ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
      ".validate": "newData.hasChildren(['sessionId', 'topic', 'startedAt', 'presenterId', 'version']) && (!data.exists() || !data.hasChild('version') || (newData.child('presenterId').val() === data.child('presenterId').val() && newData.child('version').val() === data.child('version').val()) || (newData.child('version').val() === data.child('version').val() + 1 && (data.child('live').child(data.child('presenterId').val()).val() !== true || newData.child('takeoverOf').val() === data.child('presenterId').val())))",
      "sessionId": {
        ".validate": "newData.isString() && newData.parent().parent().child('meeting_sessions').child(newData.val()).exists()"
      },
      "topic": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
      },
      "startedAt": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
      },
      "presenterId": {
        ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16,64}$/)"
      },
      "version": {
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1"
      },
      "takeoverOf": {
        ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16,64}$/)"
      },
      "live": {
        "$presenterId": {
          ".validate": "newData.val() === true && $presenterId === newData.parent().parent().child('presenterId').val()"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "live_rooms": {
      ".read": "((auth != null && root.child('users').child(auth.uid).exists()) && !root.child('deleted_users').child(auth.uid).exists())",
      "$roomId": {
        ".write": "(((auth != null && root.child('users').child(auth.uid).exists()) && !root.child('deleted_users').child(auth.uid).exists()) && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin')) && (((auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin')) && root.child('live_rooms').child($roomId).child('hostUid').val() === auth.uid) || (!data.exists() && newData.exists() && root.child('meeting_sessions').child($roomId).child('mediatorEmail').val() === auth.token.email && root.child('meeting_sessions').child($roomId).exists())))",
        ".validate": "newData.hasChildren(['hostUid', 'topic', 'slide'])",
        "hostUid": {
          ".validate": "newData.val() === auth.uid"
        },
        "topic": {
          ".validate": "newData.val() === root.child('meeting_sessions').child($roomId).child('topic').val()"
        },
        "slide": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
        },
        "online": {
          ".validate": "newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "live_room_members": {
      "$roomId": {
        ".write": "(((auth != null && root.child('users').child(auth.uid).exists()) && !root.child('deleted_users').child(auth.uid).exists()) && ((auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin')) && root.child('live_rooms').child($roomId).child('hostUid').val() === auth.uid) && !newData.exists())",
        "$uid": {
          ".write": "((((auth != null && root.child('users').child(auth.uid).exists()) && !root.child('deleted_users').child(auth.uid).exists()) && (auth != null && auth.uid === $uid) && root.child('live_rooms').child($roomId).child('online').val() === true && newData.val() === true) || (auth != null && (auth != null && auth.uid === $uid) && !newData.exists()))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "live_room_chat": {
      "$roomId": {
        ".read": "(((auth != null && root.child('users').child(auth.uid).exists()) && !root.child('deleted_users').child(auth.uid).exists()) && root.child('live_rooms').child($roomId).exists() && (((auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin')) && root.child('live_rooms').child($roomId).child('hostUid').val() === auth.uid) || root.child('live_room_members').child($roomId).child(auth.uid).val() === true))",
        ".write": "(((auth != null && root.child('users').child(auth.uid).exists()) && !root.child('deleted_users').child(auth.uid).exists()) && ((auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin')) && root.child('live_rooms').child($roomId).child('hostUid').val() === auth.uid) && !newData.exists())",
        "$messageId": {
          ".write": "(((auth != null && root.child('users').child(auth.uid).exists()) && !root.child('deleted_users').child(auth.uid).exists()) && root.child('live_rooms').child($roomId).child('online').val() === true && (((auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin')) && root.child('live_rooms').child($roomId).child('hostUid').val() === auth.uid) || root.child('live_room_members').child($roomId).child(auth.uid).val() === true) && !data.exists() && newData.exists())",
          ".validate": "newData.hasChildren(['senderUid', 'text'])",
          "senderUid": {
            ".validate": "newData.val() === auth.uid"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "flashcards": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
      "$sessionId": {
        ".read": "((auth != null && root.child('users').child(auth.uid).exists()) && (root.child('user_sessions').child(auth.uid).child($sessionId).exists() || root.child('meeting_sessions').child($sessionId).child('attendees').child(auth.uid).exists()))",
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        "$cardId": {
          ".validate": "newData.hasChildren(['front', 'back']) && newData.parent().parent().parent().child('meeting_sessions').child($sessionId).exists()",
          "front": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },
          "back": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },
          "topic": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
          },
          "sessionId": {
            ".validate": "newData.val() === $sessionId"
          },
          "createdAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "student_reviews": {
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid)",
        "$sessionId": {
          ".write": "(auth != null && auth.uid === $uid) && (auth != null && root.child('users').child(auth.uid).exists()) && ((root.child('user_sessions').child($uid).child($sessionId).exists() || root.child('meeting_sessions').child($sessionId).child('attendees').child($uid).exists()) || (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin')))",
          ".validate": "newData.hasChildren(['stage', 'lastReviewedAt']) && newData.child('stage').val() === (data.exists() ? data.child('stage').val() + 1 : 1) && newData.hasChild('stage' + newData.child('stage').val() + 'CompletedAt')",
          "stage": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 3"
          },
          "lastReviewedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
          },
          "stage1CompletedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
          },
          "stage2CompletedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
          },
          "stage3CompletedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "user_sessions": {
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid)",
        "$sessionId": {
          ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'mediator' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "newData.hasChildren(['topic', 'startedAt']) && newData.parent().parent().parent().child('meeting_sessions').child($sessionId).child('attendees').child($uid).exists()",
          "topic": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "startedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
